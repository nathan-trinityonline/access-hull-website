---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="We couldn't find that page on the Access:Hull website." noindex>
  <section class="st-hero" aria-labelledby="nf-h">
    <div class="ah-in">
      <p class="ah-eyebrow">Page not found</p>
      <h1 id="nf-h">Sorry, we can't find that page</h1>
      <p class="lead">It may have moved, or the link may be wrong. Try one of these instead.</p>
      <div class="ah-btns">
        <a class="btn btn-p" href="/">Go to the homepage</a>
        <a class="btn btn-g" href="/find-help/">Find help near you</a>
      </div>
    </div>
  </section>
</Base>
