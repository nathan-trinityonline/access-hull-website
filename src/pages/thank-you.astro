---
// Shown when a form is sent without JavaScript (the form's action). With JavaScript the
// thank-you message appears in place on the form page instead.
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Thank you for getting in touch with Access:Hull." noindex>
  <section class="ah-sec">
    <div class="ah-in narrow">
      <div class="pq-done">
        <h1>Thank you, we've received your form.</h1>
        <p>We'll be in touch soon.</p>
        <a class="btn btn-p" href="/">Back to homepage</a>
      </div>
    </div>
  </section>
</Base>
