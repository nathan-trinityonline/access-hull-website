---
// LinkedIn and Facebook links. Addresses live in src/data/social.json (editable in the content editor).
import social from '../data/social.json';

interface Props {
  class: string;
  labels?: boolean;
}
const { class: cls, labels = false } = Astro.props;
const links = [
  { name: 'LinkedIn', href: social.linkedin, box: '-2 -1 24 24', d: 'M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.5 8h4v13h-4V8zm7 0h3.8v1.8h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-6.3c0-1.5-.03-3.43-2.09-3.43-2.1 0-2.42 1.64-2.42 3.32V21h-4V8z' },
  { name: 'Facebook', href: social.facebook, box: '0 0 24 24', d: 'M14 8h3V4h-3c-2.76 0-5 2.24-5 5v2H6v4h3v9h4v-9h3l1-4h-4V9c0-.55.45-1 1-1z' },
].filter((l) => l.href);
---
<div class={`soc ${cls}`}>
  {links.map((l) => (
    <a href={l.href} target="_blank" rel="noopener" aria-label={`Access:Hull on ${l.name} (opens in a new tab)`}>
      <svg viewBox={l.box} aria-hidden="true"><path d={l.d} /></svg>{labels && <span>{l.name}</span>}
    </a>
  ))}
</div>
